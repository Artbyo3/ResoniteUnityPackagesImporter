<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite\</GamePath>
    <GamePath>$([MSBuild]::EnsureTrailingSlash('$(GamePath)'))</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Elements.Core"><HintPath>$(GamePath)Elements.Core.dll</HintPath></Reference>
    <None Include="$(GamePath)brolib_x64.dll" Link="brolib_x64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
