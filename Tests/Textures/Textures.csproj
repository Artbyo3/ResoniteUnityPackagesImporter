<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>TEXTURE_PIPELINE_TESTS</DefineConstants>
    <GamePath Condition="'$(GamePath)' == ''">$(GAMEPATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Resonite/</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Elements.Core"><HintPath>$(GamePath)/Elements.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Elements.Assets"><HintPath>$(GamePath)/Elements.Assets.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Renderite.Shared"><HintPath>$(GamePath)/Renderite.Shared.dll</HintPath><Private>False</Private></Reference>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <Compile Include="../TexturePipelineNativeTests.cs" />
    <Compile Include="../../UnityPackageImporter/Materials/MaterialTextureProcessor.cs" />
    <Compile Include="../../UnityPackageImporter/Materials/TextureCompositionPlan.cs" />
    <Compile Include="../../UnityPackageImporter/Materials/TextureCompositionBaker.cs" />
    <Compile Include="../../UnityPackageImporter/Materials/TexturePixelTransform.cs" />
    <Compile Include="../../UnityPackageImporter/Models/UnityMaterialData.cs" />
    <Compile Include="../../UnityPackageImporter/Models/MaterialDependencyDiagnostics.cs" />
    <Compile Include="../../UnityPackageImporter/Models/RgbaPng.cs" />
  </ItemGroup>
</Project>
